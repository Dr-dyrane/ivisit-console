2026/02/18 16:52:38 PG Send: {"Type":"Parse","Name":"","Query":"-- ===========================================================================\r\n-- PART 2: Backfill Existing NULL Usernames (SAFE - ONLY NULL VALUES)\r\n-- ===========================================================================\r\n\r\nDO $$\r\nDECLARE\r\n  profile_record RECORD;\r\n  new_username TEXT;\r\n  user_email TEXT;\r\n  updated_count INTEGER := 0;\r\n  skipped_count INTEGER := 0;\r\nBEGIN\r\n  RAISE NOTICE ' Starting backfill - ONLY updating profiles with NULL username...';\r\n  \r\n  -- [warning]  SAFETY: Only loops through profiles with NULL or empty username\r\n  FOR profile_record IN \r\n    SELECT p.id, p.username\r\n    FROM public.profiles p\r\n    WHERE p.username IS NULL OR p.username = ''  -- [safe] SAFETY CHECK\r\n  LOOP\r\n    -- Get email from auth.users\r\n    SELECT email INTO user_email\r\n    FROM auth.users\r\n    WHERE id = profile_record.id;\r\n    \r\n    -- If email exists, generate username\r\n    IF user_email IS NOT NULL THEN\r\n      new_username := public.generate_username_from_email(user_email);\r\n      \r\n      -- [warning]  DOUBLE SAFETY CHECK: Only update if STILL NULL\r\n      UPDATE public.profiles\r\n      SET \r\n        username = new_username,\r\n        updated_at = NOW()\r\n      WHERE id = profile_record.id\r\n        AND (username IS NULL OR username = '');  -- [safe] SAFETY CHECK IN UPDATE\r\n      \r\n      updated_count := updated_count + 1;\r\n      \r\n      RAISE NOTICE '  [done] Backfilled % -> %', user_email, new_username;\r\n    ELSE\r\n      skipped_count := skipped_count + 1;\r\n      RAISE NOTICE '  [skipped]  Skipped profile % (no email)', profile_record.id;\r\n    END IF;\r\n  END LOOP;\r\n  \r\n  RAISE NOTICE '';\r\n  RAISE NOTICE '[done] Backfilled % usernames from email', updated_count;\r\n  RAISE NOTICE '[skipped]  Skipped % profiles (no email)', skipped_count;\r\nEND $$","ParameterOIDs":null}
2026/02/18 16:52:38 PG Send: {"Type":"Bind","DestinationPortal":"","PreparedStatement":"","ParameterFormatCodes":null,"Parameters":[],"ResultFormatCodes":[]}
