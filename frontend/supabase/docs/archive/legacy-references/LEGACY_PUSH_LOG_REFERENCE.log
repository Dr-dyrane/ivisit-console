2026/02/18 16:52:39 PG Send: {"Type":"Parse","Name":"","Query":"-- DYNAMICALLY DROP ALL POLICIES ON AFFECTED TABLES\r\n    DO $$\r\n    DECLARE\r\n        pol record;\r\n        tbl text;\r\n        -- Expanded list to capture all potential policy blockers referencing organization_id or hospital_id\r\n        tables text[] := ARRAY[\r\n            'hospitals', \r\n            'profiles', \r\n            'doctors', \r\n            'ambulances', \r\n            'emergency_requests', \r\n            'service_pricing', \r\n            'room_pricing', \r\n            'wallet_ledger', \r\n            'payment_methods',\r\n            'payments',\r\n            'organization_wallets'\r\n        ];\r\n    BEGIN\r\n        FOREACH tbl IN ARRAY tables LOOP\r\n            FOR pol IN SELECT policyname FROM pg_policies WHERE tablename = tbl LOOP\r\n                EXECUTE format('DROP POLICY IF EXISTS %I ON public.%I', pol.policyname, tbl);\r\n                RAISE NOTICE 'Dropped policy % on table %', pol.policyname, tbl;\r\n            END LOOP;\r\n        END LOOP;\r\n    END $$","ParameterOIDs":null}
