2026/02/18 16:52:39 PG Send: {"Type":"Parse","Name":"","Query":"-- Update existing organization mapping if it exists, or create new one\r\nINSERT INTO public.id_mappings (entity_type, entity_id, display_id)\r\nVALUES ('hospital', 'a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a10', 'ORG-000001')\r\nON CONFLICT (display_id) DO UPDATE SET \r\n    entity_id = EXCLUDED.entity_id,\r\n    entity_type = EXCLUDED.entity_type","ParameterOIDs":null}
2026/02/18 16:52:39 PG Send: {"Type":"Bind","DestinationPortal":"","PreparedStatement":"","ParameterFormatCodes":null,"Parameters":[],"ResultFormatCodes":[]}
