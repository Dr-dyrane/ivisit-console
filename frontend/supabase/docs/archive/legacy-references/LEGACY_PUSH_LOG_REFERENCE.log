2026/02/18 16:52:39 PG Send: {"Type":"Parse","Name":"","Query":"-- 4. RPC to get organization stripe details safely\r\nCREATE OR REPLACE FUNCTION public.get_org_stripe_status(p_org_id UUID)\r\nRETURNS JSONB AS $$\r\nDECLARE\r\n    v_details JSONB;\r\nBEGIN\r\n    SELECT jsonb_build_object(\r\n        'stripe_account_id', stripe_account_id,\r\n        'stripe_customer_id', stripe_customer_id,\r\n        'payout_method_last4', payout_method_last4,\r\n        'payout_method_brand', payout_method_brand,\r\n        'is_active', is_active\r\n    ) INTO v_details\r\n    FROM public.organizations\r\n    WHERE id = p_org_id;\r\n    \r\n    RETURN v_details;\r\nEND;\r\n$$ LANGUAGE plpgsql SECURITY DEFINER","ParameterOIDs":null}
