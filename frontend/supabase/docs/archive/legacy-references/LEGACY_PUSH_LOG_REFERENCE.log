2026/02/18 16:52:38 PG Send: {"Type":"Parse","Name":"","Query":"-- ----------------------------------------------------------------------------\r\n-- Source: 20260122120000_profile_doctor_name_sync.sql\r\n-- ----------------------------------------------------------------------------\r\n\r\n-- Migration: Profile-Doctor Name Synchronization\r\n-- Description: Establishes bidirectional name sync between profiles and doctors\r\n-- Following Apple's \"Single Source of Truth\" principle\r\n\r\nBEGIN","ParameterOIDs":null}
2026/02/18 16:52:38 PG Send: {"Type":"Bind","DestinationPortal":"","PreparedStatement":"","ParameterFormatCodes":null,"Parameters":[],"ResultFormatCodes":[]}
