2026/02/18 16:52:39 PG Send: {"Type":"Parse","Name":"","Query":"-- ===========================================================\r\n-- 1. CLEANUP: Drop all policies to allow type change\r\n-- ===========================================================\r\nDO $$\r\nDECLARE\r\n    pol RECORD;\r\nBEGIN\r\n    FOR pol IN (\r\n        SELECT policyname, tablename, schemaname \r\n        FROM pg_policies \r\n        WHERE schemaname NOT IN ('pg_catalog', 'information_schema', 'pg_toast')\r\n    ) LOOP\r\n        EXECUTE 'DROP POLICY IF EXISTS ' || quote_ident(pol.policyname) || ' ON ' || quote_ident(pol.schemaname) || '.' || quote_ident(pol.tablename);\r\n    END LOOP;\r\nEND $$","ParameterOIDs":null}
2026/02/18 16:52:39 PG Send: {"Type":"Bind","DestinationPortal":"","PreparedStatement":"","ParameterFormatCodes":null,"Parameters":[],"ResultFormatCodes":[]}
