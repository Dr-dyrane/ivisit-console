2026/02/18 16:52:39 PG Send: {"Type":"Parse","Name":"","Query":"-- ----------------------------------------------------------------------------\r\n-- Source: 20260217073000_fix_visits_id_type.sql\r\n-- ----------------------------------------------------------------------------\r\n\r\n-- Migration: Fix Visits Table ID Type for Emergency Sync\r\n-- Author: Emergency Fix Implementation\r\n-- Date: 2026-02-17\r\n-- Description: Updates visits table to use UUID for id to match emergency_requests\r\n\r\n-- ============================================================================\r\n-- [tech] 1. UPDATE VISITS TABLE ID TYPE TO MATCH EMERGENCY_REQUESTS\r\n-- ============================================================================\r\n\r\n-- Drop foreign key constraints temporarily\r\nALTER TABLE public.visits DROP CONSTRAINT IF EXISTS visits_user_id_fkey CASCADE","ParameterOIDs":null}
