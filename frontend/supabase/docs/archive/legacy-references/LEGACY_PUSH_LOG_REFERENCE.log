2026/02/18 16:52:38 PG Send: {"Type":"Execute","Portal":"","MaxRows":0}
2026/02/18 16:52:38 PG Send: {"Type":"Parse","Name":"","Query":"-- 3. Add 'status' column to 'doctors' table if it doesn't exist\r\nDO $$\r\nBEGIN\r\n    IF NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_name = 'doctors' AND column_name = 'status') THEN\r\n        ALTER TABLE public.doctors ADD COLUMN status text DEFAULT 'available';\r\n    END IF;\r\nEND $$","ParameterOIDs":null}
