2026/02/18 16:52:39 PG Send: {"Type":"Parse","Name":"","Query":"COMMENT ON COLUMN public.profiles.onboarding_status IS \r\n'Tracks onboarding state: pending=in_progress, complete=done, NULL=not_started_or_legacy'","ParameterOIDs":null}
2026/02/18 16:52:39 PG Send: {"Type":"Bind","DestinationPortal":"","PreparedStatement":"","ParameterFormatCodes":null,"Parameters":[],"ResultFormatCodes":[]}
