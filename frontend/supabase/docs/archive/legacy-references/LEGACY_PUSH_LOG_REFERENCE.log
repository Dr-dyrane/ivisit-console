2026/02/18 16:52:39 PG Send: {"Type":"Parse","Name":"","Query":"-- 2. DYNAMICALLY DROP ALL POLICIES (Ensures no \"cannot alter type used in policy\" errors)\r\nDO $$\r\nDECLARE pol record;\r\nBEGIN\r\n    FOR pol IN SELECT tablename, policyname FROM pg_policies WHERE schemaname = 'public' LOOP\r\n        EXECUTE format('DROP POLICY IF EXISTS %I ON public.%I', pol.policyname, pol.tablename);\r\n    END LOOP;\r\nEND $$","ParameterOIDs":null}
