2026/02/18 16:52:39 PG Send: {"Type":"Parse","Name":"","Query":"-- ============================================================\r\n-- 1. CREATE IVISIT ORGANIZATION\r\n-- ============================================================\r\n\r\n-- Check if iVisit organization already exists\r\nINSERT INTO public.organizations (\r\n    id,\r\n    name,\r\n    contact_email,\r\n    ivisit_fee_percentage,\r\n    is_active,\r\n    created_at,\r\n    updated_at\r\n) VALUES (\r\n    'a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a10', -- Fixed UUID for consistency\r\n    'iVisit',\r\n    'admin@ivisit.com',\r\n    2.50,\r\n    TRUE,\r\n    NOW(),\r\n    NOW()\r\n) ON CONFLICT (id) DO NOTHING","ParameterOIDs":null}
2026/02/18 16:52:39 PG Send: {"Type":"Bind","DestinationPortal":"","PreparedStatement":"","ParameterFormatCodes":null,"Parameters":[],"ResultFormatCodes":[]}
