2026/02/18 16:52:39 PG Send: {"Type":"Parse","Name":"","Query":"-- ----------------------------------------------------------------------------\r\n-- Source: 20260216072100_org_admin_hospital_crud_and_storage.sql\r\n-- ----------------------------------------------------------------------------\r\n\r\n-- ============================================================\r\n-- Fix 1: Org Admins can manage hospitals in their organization\r\n-- ============================================================\r\n-- Currently only 'admin' has FOR ALL on hospitals.\r\n-- Org admins need INSERT/UPDATE/DELETE on hospitals where organization_id matches.\r\n\r\nDROP POLICY IF EXISTS \"Org Admins can manage their hospitals\" ON public.hospitals","ParameterOIDs":null}
