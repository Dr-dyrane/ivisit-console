2026/02/18 16:52:39 PG Send: {"Type":"Parse","Name":"","Query":"-------------------------------------------------------------------------------\r\n-- 🏁 FINAL SYSTEM CERTIFICATION (STAGED EVOLUTION V2)\r\n-- Folded: Feb 18, 2026. Certified: Modules 1-7.\r\n-------------------------------------------------------------------------------\r\n\r\n-- 1. Essential Helper Functions (SECURITY DEFINER to break RLS recursion)\r\nCREATE OR REPLACE FUNCTION public.get_current_user_role()\r\nRETURNS text AS $$\r\nDECLARE v_role text;\r\nBEGIN\r\n  SELECT role INTO v_role FROM public.profiles WHERE id = auth.uid();\r\n  RETURN v_role;\r\nEND;\r\n$$ LANGUAGE plpgsql STABLE SECURITY DEFINER SET search_path = public","ParameterOIDs":null}
