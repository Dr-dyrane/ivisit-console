2026/02/18 16:52:39 PG Send: {"Type":"Parse","Name":"","Query":"-- ===========================================================\r\n-- 1. UPDATE EMERGENCY REQUESTS RLS\r\n-- ===========================================================\r\n\r\n-- Ensure Org Admins can see emergencies for any hospital in their organization\r\n-- We use profiles.organization_id which can be either an Org ID or a Hospital ID\r\nDROP POLICY IF EXISTS \"Org admins see their emergencies\" ON public.emergency_requests","ParameterOIDs":null}
2026/02/18 16:52:39 PG Send: {"Type":"Bind","DestinationPortal":"","PreparedStatement":"","ParameterFormatCodes":null,"Parameters":[],"ResultFormatCodes":[]}
