2026/02/18 16:52:39 PG Send: {"Type":"Execute","Portal":"","MaxRows":0}
2026/02/18 16:52:39 PG Send: {"Type":"Parse","Name":"","Query":"-- Profiles (All relevant roles)\r\nINSERT INTO public.id_mappings (entity_type, entity_id, display_id)\r\nSELECT \r\n    CASE \r\n        WHEN p.role = 'patient' THEN 'patient'\r\n        WHEN p.role IN ('admin', 'org_admin') THEN 'admin'\r\n        WHEN p.role = 'dispatcher' THEN 'dispatcher'\r\n        WHEN p.role = 'provider' THEN 'provider'\r\n        ELSE 'user'\r\n    END,\r\n    p.id, p.display_id\r\nFROM public.profiles p\r\nWHERE p.display_id IS NOT NULL\r\nON CONFLICT (display_id) DO UPDATE SET entity_id = EXCLUDED.entity_id","ParameterOIDs":null}
