2026/02/18 16:52:38 PG Send: {"Type":"Parse","Name":"","Query":"-- 1. Fix roles for existing doctor profiles (migrated ones)\r\n-- This fixes the issue where doctors appear as \"patient\" in the profiles table\r\nUPDATE public.profiles\r\nSET role = 'provider'\r\nWHERE provider_type = 'doctor' AND role = 'patient'","ParameterOIDs":null}
2026/02/18 16:52:38 PG Send: {"Type":"Bind","DestinationPortal":"","PreparedStatement":"","ParameterFormatCodes":null,"Parameters":[],"ResultFormatCodes":[]}
