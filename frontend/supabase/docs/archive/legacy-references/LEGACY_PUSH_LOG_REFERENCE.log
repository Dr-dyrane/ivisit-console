2026/02/18 16:52:39 PG Send: {"Type":"Parse","Name":"","Query":"-- Helper: Generate next sequential display ID\r\nCREATE OR REPLACE FUNCTION public.generate_display_id(prefix TEXT)\r\nRETURNS TEXT\r\nLANGUAGE plpgsql\r\nSECURITY DEFINER\r\nSET search_path = public\r\nAS $$\r\nDECLARE\r\n    next_num INTEGER;\r\n    new_display_id TEXT;\r\nBEGIN\r\n    SELECT COALESCE(\r\n        MAX(\r\n            CAST(\r\n                SUBSTRING(display_id FROM LENGTH(prefix) + 2) \r\n                AS INTEGER\r\n            )\r\n        ),\r\n        0\r\n    ) + 1\r\n    INTO next_num\r\n    FROM public.id_mappings\r\n    WHERE display_id LIKE prefix || '-%';\r\n    \r\n    new_display_id := prefix || '-' || LPAD(next_num::TEXT, 6, '0');\r\n    RETURN new_display_id;\r\nEND;\r\n$$","ParameterOIDs":null}
