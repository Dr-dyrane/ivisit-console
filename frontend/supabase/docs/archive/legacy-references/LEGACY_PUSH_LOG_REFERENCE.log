2026/02/18 16:52:39 PG Send: {"Type":"Execute","Portal":"","MaxRows":0}
2026/02/18 16:52:39 PG Send: {"Type":"Parse","Name":"","Query":"-- Step 2: Add FK to profiles instead (profiles is the source of truth)\r\n-- Use ON DELETE CASCADE so deleting a profile cleans up their notifications\r\nDO $$\r\nBEGIN\r\n    IF NOT EXISTS (\r\n        SELECT 1 FROM pg_constraint\r\n        WHERE conrelid = 'public.notifications'::regclass\r\n        AND confrelid = 'public.profiles'::regclass\r\n    ) THEN\r\n        ALTER TABLE public.notifications\r\n        ADD CONSTRAINT notifications_user_id_fkey\r\n        FOREIGN KEY (user_id) REFERENCES public.profiles(id) ON DELETE CASCADE;\r\n    END IF;\r\nEND $$","ParameterOIDs":null}
