2026/02/18 16:52:39 PG Send: {"Type":"Parse","Name":"","Query":"-- ----------------------------------------------------------------------------\r\n-- Source: 20260217180000_post_completion_flow.sql\r\n-- ----------------------------------------------------------------------------\r\n\r\n-- ==========================================================================\r\n-- POST-COMPLETION FLOW FIX - 2026-02-17\r\n-- ==========================================================================\r\n-- Fixes:\r\n--   1. Auto-release ambulance back to 'available' on completion/cancellation\r\n--   2. Enhance sync_emergency_to_visit to handle arrival notifications\r\n--   3. Add org_admin/admin RLS policies on visits table\r\n--   4. Cleanup: prevent duplicate visits by syncing both UUID and display-ID\r\n-- ==========================================================================\r\nBEGIN","ParameterOIDs":null}
2026/02/18 16:52:39 PG Send: {"Type":"Bind","DestinationPortal":"","PreparedStatement":"","ParameterFormatCodes":null,"Parameters":[],"ResultFormatCodes":[]}
2026/02/18 16:52:39 PG Send: {"Type":"Describe","ObjectType":"P","Name":""}
2026/02/18 16:52:39 PG Send: {"Type":"Execute","Portal":"","MaxRows":0}
2026/02/18 16:52:39 PG Send: {"Type":"Parse","Name":"","Query":"-- ============================================================================\r\n-- 1. AMBULANCE RELEASE TRIGGER\r\n-- ============================================================================\r\n-- When an emergency request is completed or cancelled, release the ambulance\r\n-- back to 'available' status and clear its current_call.\r\n\r\nCREATE OR REPLACE FUNCTION public.release_ambulance_on_completion()\r\nRETURNS TRIGGER AS $$\r\nBEGIN\r\n    -- Only fire on status change to terminal states\r\n    IF (TG_OP = 'UPDATE' \r\n        AND OLD.status IS DISTINCT FROM NEW.status\r\n        AND NEW.status IN ('completed', 'cancelled')\r\n        AND NEW.ambulance_id IS NOT NULL) THEN\r\n        \r\n        UPDATE public.ambulances\r\n        SET \r\n            status = 'available',\r\n            current_call = NULL,\r\n            updated_at = NOW()\r\n        WHERE id = NEW.ambulance_id\r\n          AND status = 'on_trip';\r\n        \r\n        RAISE NOTICE '[release_ambulance] Ambulance % released back to available (emergency % -> %)',\r\n            NEW.ambulance_id, NEW.id, NEW.status;\r\n    END IF;\r\n    \r\n    RETURN NEW;\r\nEND;\r\n$$ LANGUAGE plpgsql SECURITY DEFINER","ParameterOIDs":null}
2026/02/18 16:52:39 PG Send: {"Type":"Bind","DestinationPortal":"","PreparedStatement":"","ParameterFormatCodes":null,"Parameters":[],"ResultFormatCodes":[]}
2026/02/18 16:52:39 PG Send: {"Type":"Describe","ObjectType":"P","Name":""}
2026/02/18 16:52:39 PG Send: {"Type":"Execute","Portal":"","MaxRows":0}
2026/02/18 16:52:39 PG Send: {"Type":"Parse","Name":"","Query":"DROP TRIGGER IF EXISTS on_emergency_release_ambulance ON public.emergency_requests","ParameterOIDs":null}
2026/02/18 16:52:39 PG Send: {"Type":"Bind","DestinationPortal":"","PreparedStatement":"","ParameterFormatCodes":null,"Parameters":[],"ResultFormatCodes":[]}
2026/02/18 16:52:39 PG Send: {"Type":"Describe","ObjectType":"P","Name":""}
2026/02/18 16:52:39 PG Send: {"Type":"Execute","Portal":"","MaxRows":0}
2026/02/18 16:52:39 PG Send: {"Type":"Parse","Name":"","Query":"CREATE TRIGGER on_emergency_release_ambulance\r\n    AFTER UPDATE ON public.emergency_requests\r\n    FOR EACH ROW\r\n    EXECUTE FUNCTION public.release_ambulance_on_completion()","ParameterOIDs":null}
2026/02/18 16:52:39 PG Send: {"Type":"Bind","DestinationPortal":"","PreparedStatement":"","ParameterFormatCodes":null,"Parameters":[],"ResultFormatCodes":[]}
2026/02/18 16:52:39 PG Send: {"Type":"Describe","ObjectType":"P","Name":""}
