2026/02/18 16:52:39 PG Send: {"Type":"Parse","Name":"","Query":"-- ----------------------------------------------------------------------------\r\n-- Source: 20260217170200_hotfix_current_call_jsonb.sql\r\n-- ----------------------------------------------------------------------------\r\n\r\n-- ============================================================================\r\n-- Hotfix: current_call column is JSONB, not TEXT\r\n-- Also backfill the active emergency with ambulance assignment\r\n-- ============================================================================\r\n\r\nBEGIN","ParameterOIDs":null}
2026/02/18 16:52:39 PG Send: {"Type":"Bind","DestinationPortal":"","PreparedStatement":"","ParameterFormatCodes":null,"Parameters":[],"ResultFormatCodes":[]}
