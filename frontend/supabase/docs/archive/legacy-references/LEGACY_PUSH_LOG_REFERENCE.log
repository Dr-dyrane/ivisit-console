2026/02/18 16:52:39 PG Send: {"Type":"Parse","Name":"","Query":"-- ===========================================================\r\n-- 3. APPROVE CASH PAYMENT RPC\r\n--    Called by org_admin when they accept the cash job\r\n-- ===========================================================\r\n\r\nDROP FUNCTION IF EXISTS public.approve_cash_payment(UUID, UUID)","ParameterOIDs":null}
