2026/02/18 16:52:39 PG Send: {"Type":"Parse","Name":"","Query":"-- 8. Create trigger for automatic payment processing\r\nDROP TRIGGER IF EXISTS process_payment_fees_trigger ON public.payments","ParameterOIDs":null}
2026/02/18 16:52:39 PG Send: {"Type":"Bind","DestinationPortal":"","PreparedStatement":"","ParameterFormatCodes":null,"Parameters":[],"ResultFormatCodes":[]}
