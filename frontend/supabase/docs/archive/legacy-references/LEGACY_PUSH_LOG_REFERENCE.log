2026/02/18 16:52:38 PG Send: {"Type":"Parse","Name":"","Query":"-- 2. Create function for search analytics summary\r\nCREATE OR REPLACE FUNCTION get_search_analytics_summary(\r\n    days_back integer DEFAULT 30\r\n)\r\nRETURNS TABLE(\r\n    total_searches bigint,\r\n    unique_searchers bigint,\r\n    unique_queries bigint,\r\n    avg_searches_per_user numeric,\r\n    top_query text\r\n)\r\nLANGUAGE sql\r\nSTABLE\r\nSECURITY DEFINER\r\nAS $$\r\n    SELECT \r\n        COUNT(*) as total_searches,\r\n        COUNT(DISTINCT user_id) as unique_searchers,\r\n        COUNT(DISTINCT query) as unique_queries,\r\n        CASE \r\n            WHEN COUNT(DISTINCT user_id) \u003e 0 \r\n            THEN ROUND(COUNT(*)::numeric / COUNT(DISTINCT user_id), 2)\r\n            ELSE 0 \r\n        END as avg_searches_per_user,\r\n        (SELECT query FROM (\r\n            SELECT query, COUNT(*) as cnt\r\n            FROM public.search_history\r\n            WHERE created_at \u003e= (now() - (days_back || ' days')::interval)\r\n            GROUP BY query\r\n            ORDER BY cnt DESC\r\n            LIMIT 1\r\n        ) top) as top_query\r\n    FROM public.search_history\r\n    WHERE created_at \u003e= (now() - (days_back || ' days')::interval);\r\n$$","ParameterOIDs":null}
