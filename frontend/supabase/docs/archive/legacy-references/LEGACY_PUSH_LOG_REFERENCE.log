2026/02/18 16:52:39 PG Send: {"Type":"Parse","Name":"","Query":"-- 1. Ensure foreign key exists\r\nDO $$ \r\nBEGIN\r\n    IF NOT EXISTS (\r\n        SELECT 1 \r\n        FROM information_schema.table_constraints \r\n        WHERE constraint_name = 'wallet_ledger_organization_id_fkey' \r\n        AND table_name = 'wallet_ledger'\r\n    ) THEN\r\n        ALTER TABLE public.wallet_ledger\r\n        ADD CONSTRAINT wallet_ledger_organization_id_fkey\r\n        FOREIGN KEY (organization_id)\r\n        REFERENCES public.organizations(id)\r\n        ON DELETE SET NULL;\r\n    END IF;\r\nEND $$","ParameterOIDs":null}
