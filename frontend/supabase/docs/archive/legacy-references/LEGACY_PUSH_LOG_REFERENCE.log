2026/02/18 16:52:39 PG Send: {"Type":"Parse","Name":"","Query":"-- 0. FIX generate_display_id (Make it robust against mixed prefixes)\r\nCREATE OR REPLACE FUNCTION public.generate_display_id(prefix TEXT)\r\nRETURNS TEXT\r\nLANGUAGE plpgsql\r\nSECURITY DEFINER\r\nSET search_path = public\r\nAS $$\r\nDECLARE\r\n    next_num INTEGER;\r\nBEGIN\r\n    -- Use regex to safely extract the numeric part of matching IDs\r\n    SELECT COALESCE(\r\n        MAX(\r\n            CASE \r\n                WHEN display_id ~ ('^' || prefix || '-[0-9]+$') THEN\r\n                    CAST(SUBSTRING(display_id FROM LENGTH(prefix) + 2) AS INTEGER)\r\n                ELSE 0\r\n            END\r\n        ),\r\n        0\r\n    ) + 1 INTO next_num\r\n    FROM public.id_mappings\r\n    WHERE display_id LIKE prefix || '-%';\r\n    \r\n    -- Format: PREFIX-XXXXXX (6 digits, zero-padded)\r\n    RETURN prefix || '-' || LPAD(next_num::TEXT, 6, '0');\r\nEND;\r\n$$","ParameterOIDs":null}
2026/02/18 16:52:39 PG Send: {"Type":"Bind","DestinationPortal":"","PreparedStatement":"","ParameterFormatCodes":null,"Parameters":[],"ResultFormatCodes":[]}
