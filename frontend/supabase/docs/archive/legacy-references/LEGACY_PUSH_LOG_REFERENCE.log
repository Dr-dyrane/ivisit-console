2026/02/18 16:52:38 PG Send: {"Type":"Parse","Name":"","Query":"COMMENT ON TABLE public.id_mappings IS 'Maps entity UUIDs to human-readable display IDs (IVP-000001, PRV-000001, ORG-000001)'","ParameterOIDs":null}
