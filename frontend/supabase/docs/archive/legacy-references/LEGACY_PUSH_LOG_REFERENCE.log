2026/02/18 16:52:38 PG Send: {"Type":"Parse","Name":"","Query":"-- 2) Concurrency: allow max 1 active bed booking + 1 active ambulance per user\r\nwith ranked as (\r\n  select\r\n    id,\r\n    row_number() over (\r\n      partition by user_id, service_type\r\n      order by updated_at desc nulls last, created_at desc nulls last, id desc\r\n    ) as rn\r\n  from public.emergency_requests\r\n  where service_type in ('bed', 'ambulance')\r\n    and status in ('in_progress', 'accepted', 'arrived')\r\n)\r\nupdate public.emergency_requests er\r\nset\r\n  status = 'cancelled',\r\n  cancelled_at = coalesce(er.cancelled_at, now()),\r\n  updated_at = now()\r\nfrom ranked r\r\nwhere er.id = r.id and r.rn \u003e 1","ParameterOIDs":null}
