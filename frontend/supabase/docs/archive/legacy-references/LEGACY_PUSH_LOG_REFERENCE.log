2026/02/18 16:52:38 PG Send: {"Type":"Parse","Name":"","Query":"-- CREATE POLICY \"Org admins manage hospital room pricing\" ON room_pricing\r\n--   FOR ALL USING (\r\n--     auth.uid() IN (\r\n--       SELECT id FROM profiles \r\n--       WHERE role = 'org_admin' AND organization_id = hospital_id\r\n--     )\r\n--   );\r\n\r\nCREATE POLICY \"Admins manage all room pricing\" ON room_pricing\r\n  FOR ALL USING (\r\n    auth.uid() IN (\r\n      SELECT id FROM profiles WHERE role = 'admin'\r\n    )\r\n  )","ParameterOIDs":null}
