2026/02/18 16:52:39 PG Send: {"Type":"Parse","Name":"","Query":"-- 6. SYSTEM RECOVERY: KILL RECURSION \u0026 ALIGN TYPES\r\nCREATE OR REPLACE FUNCTION public.get_current_user_role()\r\nRETURNS text\r\nLANGUAGE plpgsql\r\nSTABLE\r\nSECURITY DEFINER\r\nSET search_path = public\r\nAS $$\r\nDECLARE\r\n  v_role text;\r\nBEGIN\r\n  -- This runs as postgres (Security Definer) to avoid recursion\r\n  SELECT role INTO v_role FROM public.profiles WHERE id = auth.uid();\r\n  RETURN v_role;\r\nEND;\r\n$$","ParameterOIDs":null}
