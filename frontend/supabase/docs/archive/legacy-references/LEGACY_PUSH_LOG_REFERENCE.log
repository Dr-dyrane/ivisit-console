2026/02/18 16:52:38 PG Send: {"Type":"Parse","Name":"","Query":"-- ----------------------------------------------------------------------------\r\n-- Source: 20260116220000_admin_auth_users_access.sql\r\n-- ----------------------------------------------------------------------------\r\n\r\n-- Migration: Grant admin users access to auth.users table\r\n-- Description: Allows users with admin role in profiles to fetch all auth.users data\r\n\r\n-- Create a function to check if current user is admin\r\nCREATE OR REPLACE FUNCTION public.is_admin()\r\nRETURNS boolean\r\nLANGUAGE sql\r\nSECURITY DEFINER\r\nSET search_path = public\r\nAS $$\r\n  SELECT EXISTS (\r\n    SELECT 1 FROM public.profiles \r\n    WHERE profiles.id = auth.uid() \r\n    AND profiles.role = 'admin'\r\n  );\r\n$$","ParameterOIDs":null}
