2026/02/18 16:52:38 PG Send: {"Type":"Parse","Name":"","Query":"-- 3. Create or Replace Trending Searches Function\r\nCREATE OR REPLACE FUNCTION get_trending_searches(\r\n  days_back integer,\r\n  limit_count integer\r\n)\r\nRETURNS TABLE(query text, count bigint)\r\nLANGUAGE sql\r\nSTABLE\r\nAS $$\r\n  SELECT \r\n    search_history.query,\r\n    COUNT(*) as count\r\n  FROM public.search_history\r\n  WHERE search_history.created_at \u003e= (now() - (days_back || ' days')::interval)\r\n  GROUP BY search_history.query\r\n  ORDER BY count DESC\r\n  LIMIT limit_count;\r\n$$","ParameterOIDs":null}
