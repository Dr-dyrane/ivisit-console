2026/02/18 16:52:38 PG Send: {"Type":"Parse","Name":"","Query":"CREATE TRIGGER on_profile_name_update\r\n  AFTER UPDATE OF full_name ON public.profiles\r\n  FOR EACH ROW\r\n  WHEN (\r\n    OLD.full_name IS DISTINCT FROM NEW.full_name AND\r\n    NEW.role = 'provider' AND\r\n   NEW.provider_type = 'doctor'\r\n  )\r\n  EXECUTE FUNCTION sync_doctor_name()","ParameterOIDs":null}
