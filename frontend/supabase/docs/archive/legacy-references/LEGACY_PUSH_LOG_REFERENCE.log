\r\n        RAISE WARNING '[warning] room_pricing table is empty! Check if seed data was applied.';\r\n    END IF;\r\n\r\n    RAISE NOTICE '----------------------------------------------------------------';\r\n    RAISE NOTICE 'INTEGRITY CHECKS COMPLETE.';\r\n    RAISE NOTICE '----------------------------------------------------------------';\r\nEND;\r\n$$","ParameterOIDs":null}
