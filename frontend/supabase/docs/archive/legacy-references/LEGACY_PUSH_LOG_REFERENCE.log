2026/02/18 16:52:39 PG Send: {"Type":"Parse","Name":"","Query":"-- ----------------------------------------------------------------------------\r\n-- Source: 20260216070100_fix_user_statistics_org_filter.sql\r\n-- ----------------------------------------------------------------------------\r\n\r\n-- Migration: Fix get_user_statistics Organization Filtering\r\n-- Description: Remove organization filtering for super admins in get_user_statistics\r\n-- Issue: Super admins were incorrectly being filtered by organization_id in statistics\r\n-- Fix: Only apply org filtering to org_admin and dispatcher roles\r\n\r\n-- Drop existing function\r\nDROP FUNCTION IF EXISTS public.get_user_statistics(uuid)","ParameterOIDs":null}
