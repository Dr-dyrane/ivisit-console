2026/02/18 16:52:39 PG Send: {"Type":"Parse","Name":"","Query":"-- ----------------------------------------------------------------------------\r\n-- Source: 20260216053500_fix_profiles_rls_recursion.sql\r\n-- ----------------------------------------------------------------------------\r\n\r\n-- Fix RLS Recursion using Security Definer Function\r\n\r\n-- 1. Create Helper Function\r\nCREATE OR REPLACE FUNCTION public.check_is_org_admin(_org_id uuid)\r\nRETURNS boolean\r\nLANGUAGE plpgsql\r\nSECURITY DEFINER -- Bypasses RLS\r\nSET search_path = public -- Secure search path\r\nAS $$\r\nBEGIN\r\n  RETURN EXISTS (\r\n    SELECT 1 FROM public.profiles\r\n    WHERE id = auth.uid()\r\n    AND role = 'org_admin'\r\n    AND organization_id = _org_id\r\n  );\r\nEND;\r\n$$","ParameterOIDs":null}
