2026/02/18 16:52:38 PG Send: {"Type":"Parse","Name":"","Query":"-- Backfill existing roles to auth.users\r\nDO $$\r\nDECLARE\r\n  r RECORD;\r\nBEGIN\r\n  FOR r IN SELECT id, role FROM public.profiles LOOP\r\n    UPDATE auth.users\r\n    SET raw_app_meta_data = \r\n      CASE \r\n        WHEN raw_app_meta_data IS NULL THEN jsonb_build_object('role', r.role)\r\n        ELSE raw_app_meta_data || jsonb_build_object('role', r.role)\r\n      END\r\n    WHERE id = r.id;\r\n  END LOOP;\r\nEND;\r\n$$","ParameterOIDs":null}
