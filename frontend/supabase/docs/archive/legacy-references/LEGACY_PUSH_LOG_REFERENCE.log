2026/02/18 16:52:38 PG Send: {"Type":"Parse","Name":"","Query":"-- ===========================================================================\r\n-- PART 3: Auto-Generate Username on Profile Creation (SAFE - ONLY IF NULL)\r\n-- ===========================================================================\r\n\r\nCREATE OR REPLACE FUNCTION public.set_username_from_email()\r\nRETURNS TRIGGER AS $$\r\nDECLARE\r\n  user_email TEXT;\r\nBEGIN\r\n  -- [warning]  SAFETY: Only generate if username is NULL or empty\r\n  -- If user provides a username, we KEEP IT!\r\n  IF NEW.username IS NULL OR NEW.username = '' THEN\r\n    -- Get email from auth.users\r\n    SELECT email INTO user_email\r\n    FROM auth.users\r\n    WHERE id = NEW.id;\r\n    \r\n    -- Generate username from email\r\n    IF user_email IS NOT NULL THEN\r\n      NEW.username := public.generate_username_from_email(user_email);\r\n      RAISE NOTICE '[new] Auto-generated username: % from email: %', NEW.username, user_email;\r\n    ELSE\r\n      -- Fallback if no email: use 'user' + id prefix\r\n      NEW.username := 'user' || SUBSTRING(NEW.id::TEXT FROM 1 FOR 8);\r\n      RAISE NOTICE '[new] Fallback username generated: %', NEW.username;\r\n    END IF;\r\n  ELSE\r\n    -- User provided their own username - keep it!\r\n    RAISE NOTICE '[done] Keeping user-provided username: %', NEW.username;\r\n  END IF;\r\n  \r\n  RETURN NEW;\r\nEND;\r\n$$ LANGUAGE plpgsql SECURITY DEFINER","ParameterOIDs":null}
