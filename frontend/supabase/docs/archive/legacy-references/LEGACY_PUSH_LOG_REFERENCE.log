2026/02/18 16:52:39 PG Send: {"Type":"Parse","Name":"","Query":"-- 4. Create Trigger to automatic syncing (id_mappings -\u003e hospitals)\r\nCREATE OR REPLACE FUNCTION public.sync_hospital_display_id()\r\nRETURNS TRIGGER\r\nLANGUAGE plpgsql\r\nSECURITY DEFINER\r\nAS $$\r\nBEGIN\r\n    IF NEW.entity_type = 'hospital' THEN\r\n        UPDATE public.hospitals\r\n        SET display_id = NEW.display_id\r\n        WHERE id = NEW.entity_id;\r\n    END IF;\r\n    RETURN NEW;\r\nEND;\r\n$$","ParameterOIDs":null}
