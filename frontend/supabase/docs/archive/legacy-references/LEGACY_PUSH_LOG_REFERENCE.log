2026/02/18 16:52:39 PG Send: {"Type":"Parse","Name":"","Query":"CREATE POLICY \"Org admins see their ledger\" ON public.wallet_ledger\r\n    FOR SELECT USING (\r\n        EXISTS (\r\n            SELECT 1 FROM public.profiles p\r\n            WHERE p.id = auth.uid() \r\n            AND (\r\n                p.role = 'admin'\r\n                OR p.organization_id = wallet_ledger.organization_id\r\n                OR EXISTS (\r\n                    SELECT 1 FROM public.hospitals h \r\n                    WHERE h.id::text = p.organization_id::text \r\n                    AND h.organization_id = wallet_ledger.organization_id\r\n                )\r\n            )\r\n        )\r\n    )","ParameterOIDs":null}
