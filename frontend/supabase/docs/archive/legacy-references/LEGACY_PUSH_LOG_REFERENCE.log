2026/02/18 16:52:38 PG Send: {"Type":"Parse","Name":"","Query":"COMMENT ON FUNCTION public.generate_display_id IS 'Generates next sequential display ID for a given prefix (IVP, PRV, ORG)'","ParameterOIDs":null}
2026/02/18 16:52:38 PG Send: {"Type":"Bind","DestinationPortal":"","PreparedStatement":"","ParameterFormatCodes":null,"Parameters":[],"ResultFormatCodes":[]}
